generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CITIZEN
  OPERATOR
  ADMIN
}

enum ComplaintCategory {
  CONSUMER_PROTECTION
  LICENSING
  SPECTRUM
  POSTAL
  BROADCASTING
}

enum ComplaintStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum LicenseType {
  OPERATOR
  TYPE_APPROVAL
  SPECTRUM
  POSTAL
  BROADCASTING
}

enum LicenseStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum NoticeType {
  REGULATORY
  ALERT
  INFO
}

enum ServiceCategory {
  LICENSING
  CONSUMER_PROTECTION
  TYPE_APPROVAL
  SPECTRUM
  POSTAL
  BROADCASTING
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(CITIZEN)
  created_at    DateTime @default(now())

  complaints    Complaint[]
  applications  LicenseApplication[]
}

model Complaint {
  id               String            @id @default(uuid())
  user_id          String
  title            String
  description      String
  category         ComplaintCategory
  status           ComplaintStatus   @default(PENDING)
  reference_number String            @unique
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

model LicenseApplication {
  id               String        @id @default(uuid())
  user_id          String
  license_type     LicenseType
  business_name    String
  contact_name     String
  contact_email    String
  status           LicenseStatus @default(PENDING)
  reference_number String        @unique
  submitted_at     DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

model Notice {
  id         Int        @id @default(autoincrement())
  text       String
  type       NoticeType @default(INFO)
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now())
}

model Service {
  id        Int             @id @default(autoincrement())
  title     String
  text      String
  category  ServiceCategory
  is_active Boolean         @default(true)
}

model AboutSlide {
  id            Int    @id @default(autoincrement())
  kicker        String
  heading       String
  body          String
  display_order Int    @default(0)
}

model ContactEnquiry {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String
  message    String
  created_at DateTime @default(now())
}
